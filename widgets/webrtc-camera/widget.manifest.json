      "widget.snapshot": "حفظ لقطة",
      "widget.snapshotUnavailable": "إطار الكاميرا غير جاهز",
      "widget.closeSnapshot": "إغلاق اللقطة",
      "widget.pictureInPicture": "صورة داخل صورة",
      "widget.fullscreen": "ملء الشاشة",
      "widget.zoom": "تكبير"
    }
  },
  "security": {
    "permissions": [
      "camera",
      "fullscreen"
    ],
    "sandbox": [
      "allow-scripts"
    ],
    "csp": {
      "connect_src": []
    }
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "WebRTC camera",
    "summary": "Watch a low-latency live camera from a PiPhi dashboard.",
    "category": "camera",
    "regions": [
      "WW"
    ],
    "languages": [
      "en",
      "es",
      "ar"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi_network_webRTC/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "camera_stream",
        "label": "Camera stream access",
        "reason": "Receives video, and optional audio, from the camera selected in the dashboard.",
        "required": true
      },
      {
        "id": "fullscreen",
        "label": "Fullscreen display",
        "reason": "Lets the homeowner expand the active camera view after pressing the fullscreen control.",
        "required": false
      }
    ],
    "compatibility": [
      {
        "capability": "camera_stream",
        "host_protocol": "piphi.widget.host/1",
        "widget_sdk": ">=0.4.0"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi_network_webRTC",
    "support_url": "https://github.com/PiPhi-io/piphi_network_webRTC/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi_network_webRTC/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    }
  },
  "integrity": "sha256-pS3HUbeaTvDk4P29dhEB+tJzGtGYU6AgDjlSlsZ8gvc="
}
